# Copy to .env — vm/bootstrap.sh does this for you and fills in the generated
# values. Nothing in here should ever be committed.

# ── Yours, from your instructor and from azure/03-signin-app.sh ───────────
MINIHR_DOMAIN=student01.lab.fortisentinel.org
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# ── The image, published by the course ────────────────────────────────────
# Pinned by digest rather than tag: a tag can be repointed under you.
MINIHR_IMAGE=ghcr.io/cybervaultschool/minihr-lab@sha256:7c9b9b825968828e21aaea39b4a18bfa2939f14b444dce9440b874056622c5e7

# ── Generated on the machine, never typed and never shared ────────────────
# bootstrap.sh writes these with `openssl rand`. If you are filling this in by
# hand you are doing something unusual — generate them, do not invent them:
#   openssl rand -base64 32
POSTGRES_PASSWORD=
MINIHR_APP_PASSWORD=
BETTER_AUTH_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
