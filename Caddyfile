# TLS termination and reverse proxy.
#
# Caddy obtains and renews a Let's Encrypt certificate automatically, which is
# the whole reason it is here: Google and Microsoft OAuth both require an HTTPS
# redirect URI, so a self-hosted deployment needs real certificates from the
# first sign-in, not eventually.
#
# Set MINIHR_DOMAIN in .env.production to the public hostname.

{$MINIHR_DOMAIN} {
	encode zstd gzip

	# The application resolves the caller's address from these, and writes it to
	# the audit trail. Without them every audit row records the proxy.
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 10
		}
	}
}
